# --- Database: Postgres is the only service (pgvector + pgvectorscale + pg_textsearch) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/rag

# --- API ---
# Clients send "Authorization: Bearer <API_KEY>". Leave empty only for local development.
API_KEY=change-me
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
ALLOWED_HOSTS=*
# Behind an HTTPS reverse proxy (needed for the admin login):
# CSRF_TRUSTED_ORIGINS=https://rag.example.com
# BEHIND_HTTPS_PROXY=true

# --- Chat model ---
# "openai" = OpenAI or any OpenAI-compatible server (LiteLLM proxy, vLLM, Ollama...), "anthropic" = Claude
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:4000/v1      # e.g. your LiteLLM proxy
OPENAI_MODEL=gpt-5.5
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Retry declined requests on a fallback model. Claude API only: set false for Bedrock/Vertex/proxies.
ANTHROPIC_FALLBACKS=true
# Optional default reasoning effort for every model call: low | medium | high
# LLM_EFFORT=low

# --- Embeddings (an OpenAI-compatible endpoint; defaults to the OPENAI_* settings above) ---
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model. Fixed when you first run "migrate": changing it later needs a new database.
EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# --- Search ---
# "english" stems English words. Use "simple" for Persian, Arabic and most other languages,
# then run: python manage.py rebuild_search_indexes
TEXT_SEARCH_CONFIG=english
CHUNK_SIZE=1500
CHUNK_OVERLAP=150

# --- Your products database (used in a data source URL as env:PRODUCTS_DB_URL) ---
# PRODUCTS_DB_URL=mysql://reader:password@host.docker.internal:3306/shop
